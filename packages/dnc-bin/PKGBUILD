# Maintainer: Peilin Fan <peilin.fan@foxmail.com>
pkgname=dnc-bin
pkgver=0.5.0
pkgrel=1
pkgdesc='Lightweight application packager for the shared dnr runtime (prebuilt)'
arch=('x86_64')
url='https://github.com/fansion314/dnr'
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('base-devel: build Arch application packages with dnc')
provides=("dnc=$pkgver")
conflicts=('dnc')
options=('!strip' '!debug')
_package="dnc-$pkgver-1-x86_64.pkg.tar.zst"
_release="$url/releases/download/v$pkgver"
source=("$_release/$_package" "$_release/$_package.sha256")
noextract=("$_package")
# CI creates the archive after this tag exists. Verify its release checksum below.
sha256sums=('SKIP' 'SKIP')

prepare() {
    cd "$srcdir"
    local digest filename extra
    read -r digest filename extra < "$_package.sha256"
    [[ $digest =~ ^[0-9a-f]{64}$ && $filename == "$_package" && -z $extra ]] || return 1
    printf '%s  %s\n' "$digest" "$_package" | sha256sum --check --status || return 1
    mkdir -p payload
    bsdtar -xf "$_package" -C payload usr/bin/dnc usr/share/licenses/dnc usr/share/doc/dnc
}

package() {
    cd "$srcdir/payload"
    install -Dm755 usr/bin/dnc "$pkgdir/usr/bin/dnc"
    install -d "$pkgdir/usr/share/licenses/$pkgname" "$pkgdir/usr/share/doc/$pkgname"
    cp -r --no-preserve=ownership usr/share/licenses/dnc/. "$pkgdir/usr/share/licenses/$pkgname/"
    cp -r --no-preserve=ownership usr/share/doc/dnc/. "$pkgdir/usr/share/doc/$pkgname/"
}

# Pinned by fansion314/aur after verifying the published release bytes.
sha256sums=('42f1da58c01268cdfe92f3af357efbe11d42e6ea7cfe9314a710f5eb05f8185a' '67261ea675da2e622264a560b12203f33b1fb7ec46bbae6c2fa56b1141d2266c')
