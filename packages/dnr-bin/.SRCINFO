pkgbase = dnr-bin
	pkgdesc = Shared Deno runtime (system CEF + WebView, prebuilt)
	pkgver = 0.5.2
	pkgrel = 1
	url = https://github.com/fansion314/dnr
	arch = x86_64
	license = MIT
	license = Apache-2.0
	license = BSD-3-Clause
	depends = glibc
	depends = gcc-libs
	depends = zlib
	optdepends = libxss: X11 session idle time monitoring
	optdepends = cef: system CEF desktop backend (also requires gtk3)
	optdepends = gtk3: native desktop UI for the CEF backend
	optdepends = webkit2gtk-4.1: WebView desktop backend (auto fallback)
	optdepends = libayatana-appindicator: system tray support
	optdepends = libnotify: desktop notifications via notify-send
	provides = dnr=0.5.2
	conflicts = dnr
	conflicts = dnr-cef
	conflicts = dnr-cef-bin
	conflicts = dnr-webview
	conflicts = dnr-webview-bin
	noextract = dnr-0.5.2-1-x86_64.pkg.tar.zst
	options = !strip
	options = !debug
