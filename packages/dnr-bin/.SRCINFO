pkgbase = dnr-bin
	pkgdesc = Shared Deno runtime (system CEF + WebView, prebuilt)
	pkgver = 0.4.2
	pkgrel = 1
	url = https://github.com/fansion314/dnr
	arch = x86_64
	license = MIT
	license = Apache-2.0
	license = BSD-3-Clause
	depends = glibc
